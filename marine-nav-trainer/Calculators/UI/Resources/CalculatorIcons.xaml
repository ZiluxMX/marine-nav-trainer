<!--
    Zestaw ikon kalkulatorów - styl liniowy, siatka 24x24, jednolita grubość linii 1.5
    i zaokrąglone zakończenia. Każda ikona ma dwa zasoby:
      *IconGeometry     - geometria (do własnych zastosowań, np. Path w innym miejscu)
      *Icon             - gotowy PathIcon do wstawienia w Icon="..." kontrolek WPF-UI

    Zasoby PathIcon mają x:Shared="False", więc każde odwołanie StaticResource
    tworzy nową instancję i tę samą ikonę można użyć w kilku miejscach naraz.
    Segment wsparty przez AI
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:marine_nav_trainer.Calculators.UI.Controls">

    <!-- 01  Wiatr pozorny - trzy fale -->
    <Geometry x:Key="ApparentWindIconGeometry">
        M2,7.5 C3.8,4.9 5.7,4.9 7.5,7.5 S11.2,10.1 13,7.5 16.7,4.9 18.5,7.5
        M4.5,13 C6.3,10.4 8.2,10.4 10,13 S13.7,15.6 15.5,13 19.2,10.4 21,13
        M2,18.5 C3.8,15.9 5.7,15.9 7.5,18.5 S11.2,21.1 13,18.5
    </Geometry>

    <!-- 02  Trawers - trójkąt z kątem prostym -->
    <Geometry x:Key="CrossbarIconGeometry">
        M3.5,3.5 L3.5,20.5 L20.5,20.5 Z
        M3.5,16.5 L7.5,16.5 L7.5,20.5
    </Geometry>

    <!-- 03  Przesunięcie LOP - dwie obserwacje -->
    <Geometry x:Key="RunningFixIconGeometry">
        M13.5,8.5 C11.1,12.1 4.9,12.1 2.5,8.5 C4.9,4.9 11.1,4.9 13.5,8.5 Z
        M6.1,8.5 A1.9,1.9 0 1 0 9.9,8.5 A1.9,1.9 0 1 0 6.1,8.5 Z
        M22.5,15.5 C20.1,19.1 13.9,19.1 11.5,15.5 C13.9,11.9 20.1,11.9 22.5,15.5 Z
        M15.1,15.5 A1.9,1.9 0 1 0 18.9,15.5 A1.9,1.9 0 1 0 15.1,15.5 Z
    </Geometry>

    <!-- 04  Pozycja obserwowana - oko -->
    <Geometry x:Key="ObservedPositionIconGeometry">
        M22,12 C19.1,16.7 4.9,16.7 2,12 C4.9,7.3 19.1,7.3 22,12 Z
        M9,12 A3,3 0 1 0 15,12 A3,3 0 1 0 9,12 Z
    </Geometry>

    <!-- 05  Pozycja zliczona - kalkulator -->
    <Geometry x:Key="DeadReckoningIconGeometry">
        M6.5,2.5 L17.5,2.5 A2.5,2.5 0 0 1 20,5 L20,19 A2.5,2.5 0 0 1 17.5,21.5
        L6.5,21.5 A2.5,2.5 0 0 1 4,19 L4,5 A2.5,2.5 0 0 1 6.5,2.5 Z
        M7.8,5.5 L16.2,5.5 A0.8,0.8 0 0 1 17,6.3 L17,8.2 A0.8,0.8 0 0 1 16.2,9
        L7.8,9 A0.8,0.8 0 0 1 7,8.2 L7,6.3 A0.8,0.8 0 0 1 7.8,5.5 Z
    </Geometry>
    <Geometry x:Key="DeadReckoningIconFillGeometry">
        M6.45,13 A1.05,1.05 0 1 0 8.55,13 A1.05,1.05 0 1 0 6.45,13 Z
        M10.95,13 A1.05,1.05 0 1 0 13.05,13 A1.05,1.05 0 1 0 10.95,13 Z
        M15.45,13 A1.05,1.05 0 1 0 17.55,13 A1.05,1.05 0 1 0 15.45,13 Z
        M6.45,17.5 A1.05,1.05 0 1 0 8.55,17.5 A1.05,1.05 0 1 0 6.45,17.5 Z
        M10.95,17.5 A1.05,1.05 0 1 0 13.05,17.5 A1.05,1.05 0 1 0 10.95,17.5 Z
        M15.45,17.5 A1.05,1.05 0 1 0 17.55,17.5 A1.05,1.05 0 1 0 15.45,17.5 Z
    </Geometry>

    <!-- 06  Kurs - droga między dwoma punktami -->
    <Geometry x:Key="CourseIconGeometry">
        M17,4 C17,8.5 7,8.5 7,12 C7,15.5 17,15.5 17,20
    </Geometry>
    <Geometry x:Key="CourseIconFillGeometry">
        M14.9,4 A2.1,2.1 0 1 0 19.1,4 A2.1,2.1 0 1 0 14.9,4 Z
        M14.9,20 A2.1,2.1 0 1 0 19.1,20 A2.1,2.1 0 1 0 14.9,20 Z
    </Geometry>

    <controls:PathIcon x:Key="ApparentWindIcon" x:Shared="False"
                       Data="{StaticResource ApparentWindIconGeometry}" />

    <controls:PathIcon x:Key="CrossbarIcon" x:Shared="False"
                       Data="{StaticResource CrossbarIconGeometry}" />

    <controls:PathIcon x:Key="RunningFixIcon" x:Shared="False"
                       Data="{StaticResource RunningFixIconGeometry}" />

    <controls:PathIcon x:Key="ObservedPositionIcon" x:Shared="False"
                       Data="{StaticResource ObservedPositionIconGeometry}" />

    <controls:PathIcon x:Key="DeadReckoningIcon" x:Shared="False"
                       Data="{StaticResource DeadReckoningIconGeometry}"
                       FillData="{StaticResource DeadReckoningIconFillGeometry}" />

    <!-- StrokeDashArray liczony w wielokrotnościach grubości linii: 0.1/1.5 i 3.4/1.5 -->
    <controls:PathIcon x:Key="CourseIcon" x:Shared="False"
                       Data="{StaticResource CourseIconGeometry}"
                       FillData="{StaticResource CourseIconFillGeometry}"
                       StrokeDashArray="0.067 2.267" />

</ResourceDictionary>
