<UserControl x:Class="marine_nav_trainer.Calculators.UI.Views.CalculatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:marine_nav_trainer.Calculators.UI.Views"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="550">
    <Grid>
        <ui:Card VerticalAlignment="Stretch" VerticalContentAlignment="Top" HorizontalAlignment="Stretch" Padding="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        BorderThickness="1,1,1,1"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                    <ui:NavigationView Grid.Column="0" IsBackButtonVisible="Collapsed" PaneHeader="Kalkulatory" MaxWidth="195" MinHeight="450">
                        <ui:NavigationView.MenuItems>
                            <ui:NavigationViewItem Content="Kurs" Tag="course" Icon="{StaticResource CourseIcon}" PreviewMouseLeftButtonUp="NavItemOnClick" HorizontalAlignment="Left" Width="185"/>
                            <ui:NavigationViewItem Content="Wiatr pozorny" Tag="apparentWind" Icon="{StaticResource ApparentWindIcon}" PreviewMouseLeftButtonUp="NavItemOnClick" HorizontalAlignment="Left" Width="185"/>
                            <ui:NavigationViewItem Content="Trawers" Tag="crossbar" Icon="{StaticResource CrossbarIcon}" PreviewMouseLeftButtonUp="NavItemOnClick" HorizontalAlignment="Left" Width="185"/>
                            <ui:NavigationViewItem Content="Pozycja obserwowana" Tag="observedPosition" Icon="{StaticResource ObservedPositionIcon}" PreviewMouseLeftButtonUp="NavItemOnClick" HorizontalAlignment="Left" Width="185"/>
                            <ui:NavigationViewItem Content="Przesunięcie LOP" Tag="runningFix" Icon="{StaticResource RunningFixIcon}" PreviewMouseLeftButtonUp="NavItemOnClick" HorizontalAlignment="Left" Width="185"/>
                            <ui:NavigationViewItem Content="Pozycja zliczona" Tag="deadReckoning" Icon="{StaticResource DeadReckoningIcon}" PreviewMouseLeftButtonUp="NavItemOnClick" HorizontalAlignment="Left" Width="185"/>
                        </ui:NavigationView.MenuItems>
                    </ui:NavigationView>
                </Border>
                <Border Grid.Column="1"
                        BorderThickness="1,1,1,1"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                    <Grid Grid.Column="1"
                          MaxWidth="350">
                        <ContentControl x:Name="CalculatorContent"/>
                    </Grid>
                </Border>
            </Grid>
        </ui:Card>
    </Grid>
</UserControl>
