<UserControl x:Class="marine_nav_trainer.Calculators.UI.Views.Tabs.CourseTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             MinWidth="350"  MaxWidth="400"
             d:DesignHeight="550" d:Width="350">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="15,5,15,5"
                BorderThickness="0,1,0,1"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:TextBlock Text="Kurs" FontTypography="Subtitle" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12,4,12,4">

                <!-- Kursy -->
                <ui:TextBlock Text="Kursy" FontTypography="BodyStrong" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <ui:TextBlock Text="KK - kompasowy (°)"/>
                        <ui:NumberBox x:Name="CompassCourseBox" Margin="0,2,0,0"
                                      Minimum="0" Maximum="360" MaxDecimalPlaces="1"
                                      ClearButtonEnabled="True" SpinButtonPlacementMode="Inline"
                                      Padding="8,4,8,4"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2">
                        <ui:TextBlock Text="KM - magnetyczny (°)"/>
                        <ui:NumberBox x:Name="MagneticCourseBox" Margin="0,2,0,0"
                                      Minimum="0" Maximum="360" MaxDecimalPlaces="1"
                                      ClearButtonEnabled="True" SpinButtonPlacementMode="Inline"
                                      Padding="8,4,8,4"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,6,0,0">
                        <ui:TextBlock Text="KR - rzeczywisty (°)"/>
                        <ui:NumberBox x:Name="TrueCourseBox" Margin="0,2,0,0"
                                      Minimum="0" Maximum="360" MaxDecimalPlaces="1"
                                      ClearButtonEnabled="True" SpinButtonPlacementMode="Inline"
                                      Padding="8,4,8,4"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,6,0,0">
                        <ui:TextBlock Text="KDd - kąt drogi (°)"/>
                        <ui:NumberBox x:Name="GroundCourseBox" Margin="0,2,0,0"
                                      Minimum="0" Maximum="360" MaxDecimalPlaces="1"
                                      ClearButtonEnabled="True" SpinButtonPlacementMode="Inline"
                                      Padding="8,4,8,4"/>
                    </StackPanel>
                </Grid>

                <ui:TextBlock Text="Oblicz na podstawie"/>
                <ComboBox x:Name="SourceBox" Margin="0,2,0,12"
                          SelectedIndex="0"
                          Height="31"
                          Padding="8,4,8,4">
                    <ComboBoxItem Content="KK - kompasowy" Tag="KK"/>
                    <ComboBoxItem Content="KM - magnetyczny" Tag="KM"/>
                    <ComboBoxItem Content="KR - rzeczywisty" Tag="KR"/>
                    <ComboBoxItem Content="KDd - kąt drogi" Tag="KDD"/>
                </ComboBox>

                <Separator Margin="0,0,0,5"/>

                <!-- Poprawki -->
                <ui:TextBlock Text="Poprawki" FontTypography="BodyStrong" Margin="0,0,0,6"/>
                <ui:TextBlock Text="Kierunek wiatru (°)"/>
                <ui:NumberBox x:Name="WindDirectionBox" Margin="0,2,0,0"
                              HorizontalAlignment="Left" Width="140"
                              Minimum="0" Maximum="360" MaxDecimalPlaces="1"
                              ClearButtonEnabled="False" SpinButtonPlacementMode="Inline"
                              Padding="8,4,8,4"/>

                <ui:TextBlock Text="Deklinacja (E +, W -)" Margin="0,6,0,0"/>
                <Grid Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ui:NumberBox x:Name="VariationDegBox" Grid.Column="0"
                                  Minimum="-180" Maximum="180" MaxDecimalPlaces="0"
                                  ClearButtonEnabled="False" SpinButtonPlacementMode="Inline"
                                  PlaceholderText="°"
                                  Padding="8,4,8,4"/>
                    <ui:NumberBox x:Name="VariationMinBox" Grid.Column="2"
                                  Minimum="0" Maximum="59.9" MaxDecimalPlaces="1"
                                  ClearButtonEnabled="False" SpinButtonPlacementMode="Inline"
                                  PlaceholderText="′"
                                  Padding="8,4,8,4"/>
                    <ui:Button Grid.Column="4"
                               ToolTip="Pobierz deklinację z ramki"
                               Appearance="Secondary"
                               Height="31"
                               Padding="8,4,8,4"
                               Click="RefreshVariation_Click">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="ArrowSync24"/>
                        </ui:Button.Icon>
                    </ui:Button>
                </Grid>

                <ui:Button Content="Oblicz" Click="Oblicz_Click" HorizontalAlignment="Right" Margin="0,12,0,12"/>

                <Separator Margin="0,0,0,5"/>

                <!-- Użyte poprawki -->
                <ui:TextBlock Text="Użyte poprawki" FontTypography="BodyStrong" Margin="0,0,0,6"/>
                <ui:TextBlock x:Name="SummaryText"
                              Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                              TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
