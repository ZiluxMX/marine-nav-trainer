<UserControl x:Class="marine_nav_trainer.Windows.Views.TaskCompareDescriptionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:marine_nav_trainer.Windows.Views"
             xmlns:md="clr-namespace:MdXaml;assembly=MdXaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             MinWidth="320"
             d:DesignHeight="600" d:DesignWidth="550">
    <Grid>
        <ui:Card VerticalAlignment="Stretch" VerticalContentAlignment="Top" HorizontalAlignment="Stretch" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="15,5,15,5"
                        BorderThickness="0,1,0,1"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:TextBlock Text="Opis zadania" FontTypography="Subtitle" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="1" Margin="12,4,12,8">
                    <!-- Zadanie wzorcowe -->
                    <ui:TextBlock x:Name="ReferenceCaption" Text="Zadanie wzorcowe"
                                  FontTypography="BodyStrong"
                                  Margin="0,0,0,6"
                                  Visibility="Collapsed"/>

                    <ui:TextBlock Text="Tytuł" FontTypography="BodyStrong"/>
                    <ui:TextBlock x:Name="ReferenceTitleText" Margin="0,2,0,0"
                                  TextWrapping="Wrap"/>

                    <ui:TextBlock Text="Autor" FontTypography="BodyStrong" Margin="0,8,0,0"/>
                    <ui:TextBlock x:Name="ReferenceAuthorText" Margin="0,2,0,0"
                                  TextWrapping="Wrap"/>

                    <ui:TextBlock Text="Treść zadania" FontTypography="BodyStrong" Margin="0,8,0,0"/>
                    <Border Margin="0,4,0,0" Padding="8,4,8,4"
                            MinHeight="120"
                            HorizontalAlignment="Stretch"
                            CornerRadius="4"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                        <md:MarkdownScrollViewer x:Name="ReferenceContentPreview"
                                                 MarkdownStyleName="Standard"
                                                 VerticalScrollBarVisibility="Disabled"
                                                 HorizontalScrollBarVisibility="Auto"
                                                 Background="Transparent"/>
                    </Border>

                    <!-- Zadanie do sprawdzenia - tylko gdy ramka się różni -->
                    <StackPanel x:Name="CheckedSection" Visibility="Collapsed">
                        <Separator Margin="0,12,0,8"/>

                        <ui:TextBlock Text="Zadanie do sprawdzenia"
                                      FontTypography="BodyStrong"
                                      Margin="0,0,0,6"/>

                        <ui:TextBlock Text="Tytuł" FontTypography="BodyStrong"/>
                        <ui:TextBlock x:Name="CheckedTitleText" Margin="0,2,0,0"
                                      TextWrapping="Wrap"/>

                        <ui:TextBlock Text="Autor" FontTypography="BodyStrong" Margin="0,8,0,0"/>
                        <ui:TextBlock x:Name="CheckedAuthorText" Margin="0,2,0,0"
                                      TextWrapping="Wrap"/>

                        <ui:TextBlock Text="Treść zadania" FontTypography="BodyStrong" Margin="0,8,0,0"/>
                        <Border Margin="0,4,0,0" Padding="8,4,8,4"
                                MinHeight="120"
                                HorizontalAlignment="Stretch"
                                CornerRadius="4"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                            <md:MarkdownScrollViewer x:Name="CheckedContentPreview"
                                                     MarkdownStyleName="Standard"
                                                     VerticalScrollBarVisibility="Disabled"
                                                     HorizontalScrollBarVisibility="Auto"
                                                     Background="Transparent"/>
                        </Border>
                    </StackPanel>

                    <!-- Notatki - tylko z plików, które je mają -->
                    <StackPanel x:Name="ReferenceMemoSection" Visibility="Collapsed">
                        <Separator Margin="0,12,0,8"/>

                        <ui:TextBlock Text="Notatki - zadanie wzorcowe" FontTypography="BodyStrong"/>
                        <ui:TextBox x:Name="ReferenceMemoBox"
                                    Margin="0,2,0,0" Padding="8,4,8,4"
                                    IsReadOnly="True"
                                    AcceptsReturn="True"
                                    TextWrapping="Wrap"
                                    ClearButtonEnabled="False"
                                    VerticalContentAlignment="Top"/>
                    </StackPanel>

                    <StackPanel x:Name="CheckedMemoSection" Visibility="Collapsed">
                        <Separator Margin="0,12,0,8"/>

                        <ui:TextBlock Text="Notatki - zadanie do sprawdzenia" FontTypography="BodyStrong"/>
                        <ui:TextBox x:Name="CheckedMemoBox"
                                    Margin="0,2,0,0" Padding="8,4,8,4"
                                    IsReadOnly="True"
                                    AcceptsReturn="True"
                                    TextWrapping="Wrap"
                                    ClearButtonEnabled="False"
                                    VerticalContentAlignment="Top"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ui:Card>
    </Grid>
</UserControl>
