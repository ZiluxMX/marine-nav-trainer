<UserControl x:Class="marine_nav_trainer.Navigation.UI.Views.TaskCompareDeviationTableView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:marine_nav_trainer.Navigation.UI.Views"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             MinWidth="320"
             d:DesignHeight="300" d:DesignWidth="550">
    <Grid>
        <ui:Card VerticalAlignment="Stretch" VerticalContentAlignment="Top" HorizontalAlignment="Stretch" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="15,5,15,5"
                        BorderThickness="0,1,0,1"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:TextBlock Text="Tabela dewiacji" FontTypography="Subtitle" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="1" Margin="12,8,12,12">
                    <!-- Zadanie wzorcowe -->
                    <ui:TextBlock x:Name="ReferenceCaption" Text="Zadanie wzorcowe"
                                  FontTypography="BodyStrong"
                                  Margin="0,0,0,6"
                                  Visibility="Collapsed"/>

                    <Border VerticalAlignment="Top" Style="{StaticResource TableFrame}">
                        <Grid x:Name="ReferenceTable">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </Border>

                    <!-- Zadanie do sprawdzenia - tylko gdy ramka się różni -->
                    <StackPanel x:Name="CheckedSection" Visibility="Collapsed">
                        <ui:TextBlock Text="Zadanie do sprawdzenia"
                                      FontTypography="BodyStrong"
                                      Margin="0,12,0,6"/>

                        <Border VerticalAlignment="Top" Style="{StaticResource TableFrame}">
                            <Grid x:Name="CheckedTable">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ui:Card>
    </Grid>
</UserControl>
