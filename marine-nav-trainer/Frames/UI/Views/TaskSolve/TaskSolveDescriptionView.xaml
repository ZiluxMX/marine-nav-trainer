<UserControl x:Class="marine_nav_trainer.Windows.Views.TaskSolveDescriptionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:marine_nav_trainer.Windows.Views"
             xmlns:md="clr-namespace:MdXaml;assembly=MdXaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             MinWidth="320"
             d:DesignHeight="600" d:DesignWidth="550">
    <Grid>
        <ui:Card VerticalAlignment="Stretch" VerticalContentAlignment="Top" HorizontalAlignment="Stretch" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="15,5,15,5"
                        BorderThickness="0,1,0,1"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:TextBlock Text="Opis zadania" FontTypography="Subtitle" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="1" Margin="12,4,12,8">
                    <!-- Dane z zadania - tylko do odczytu -->
                    <ui:TextBlock Text="Tytuł" FontTypography="BodyStrong"/>
                    <ui:TextBlock x:Name="TitleText" Margin="0,2,0,0"
                                  TextWrapping="Wrap"/>

                    <ui:TextBlock Text="Autor" FontTypography="BodyStrong" Margin="0,8,0,0"/>
                    <ui:TextBlock x:Name="AuthorText" Margin="0,2,0,0"
                                  TextWrapping="Wrap"/>

                    <ui:TextBlock Text="Treść zadania" FontTypography="BodyStrong" Margin="0,8,0,0"/>
                    <Border x:Name="ContentBorder"
                            Margin="0,4,0,0" Padding="8,4,8,4"
                            MinHeight="120"
                            HorizontalAlignment="Stretch"
                            CornerRadius="4"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                        <md:MarkdownScrollViewer x:Name="ContentPreview"
                                                 MarkdownStyleName="Standard"
                                                 VerticalScrollBarVisibility="Disabled"
                                                 HorizontalScrollBarVisibility="Auto"
                                                 Background="Transparent"/>
                    </Border>

                    <!-- Dane ustalane przez ucznia -->
                    <Border Margin="0,10,0,0" Padding="0,10,0,0"
                            BorderThickness="0,1,0,0"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ui:TextBlock Grid.Row="0" Grid.Column="0" Text="Data rozpoczęcia"/>
                            <DatePicker x:Name="StartDatePicker" Grid.Row="1" Grid.Column="0"
                                        Margin="0,2,0,0"
                                        FirstDayOfWeek="Monday"
                                        SelectedDateFormat="Short"
                                        SelectedDateChanged="StartDate_SelectedDateChanged"/>

                            <ui:TextBlock Grid.Row="0" Grid.Column="2" Text="Strefa czasowa"/>
                            <ComboBox x:Name="TimeZoneBox" Grid.Row="1" Grid.Column="2"
                                      Margin="0,2,0,0"
                                      IsEditable="False"
                                      DisplayMemberPath="Display"
                                      MaxDropDownHeight="260"/>
                        </Grid>
                    </Border>

                    <!-- Notatki ucznia -->
                    <ui:TextBlock Text="Notatki własne" FontTypography="BodyStrong" Margin="0,10,0,0"/>

                    <WrapPanel x:Name="SymbolsToolbar" Orientation="Horizontal" Margin="0,2,0,0">
                        <ui:Button Content="°" Tag="°"
                                   ToolTip="Stopień"
                                   Margin="4,4,4,4" Padding="6,1,6,1"
                                   MinWidth="30"
                                   Appearance="Secondary"
                                   Click="InsertSymbolOnClick"/>
                        <ui:Button Content="′" Tag="′"
                                   ToolTip="Minuta"
                                   Margin="4,4,4,4" Padding="6,1,6,1"
                                   MinWidth="30"
                                   Appearance="Secondary"
                                   Click="InsertSymbolOnClick"/>
                        <ui:Button Content="δ" Tag="δ"
                                   ToolTip="Delta - dewiacja"
                                   Margin="4,4,4,4" Padding="6,1,6,1"
                                   MinWidth="30"
                                   Appearance="Secondary"
                                   Click="InsertSymbolOnClick"/>
                        <ui:Button Content="φ" Tag="φ"
                                   ToolTip="Fi - szerokość geograficzna"
                                   Margin="4,4,4,4" Padding="6,1,6,1"
                                   MinWidth="30"
                                   Appearance="Secondary"
                                   Click="InsertSymbolOnClick"/>
                        <ui:Button Content="λ" Tag="λ"
                                   ToolTip="Lambda - długość geograficzna"
                                   Margin="4,4,4,4" Padding="6,1,6,1"
                                   MinWidth="30"
                                   Appearance="Secondary"
                                   Click="InsertSymbolOnClick"/>
                    </WrapPanel>

                    <ui:TextBox x:Name="NotesBox"
                                Margin="0,2,0,0" Padding="8,4,8,4"
                                MinHeight="140"
                                AcceptsReturn="True"
                                AcceptsTab="True"
                                TextWrapping="Wrap"
                                SpellCheck.IsEnabled="True"
                                VerticalContentAlignment="Top"
                                VerticalScrollBarVisibility="Auto"
                                PlaceholderText="Notatki własne"/>
                </StackPanel>
            </Grid>
        </ui:Card>
    </Grid>
</UserControl>
