<UserControl x:Class="marine_nav_trainer.Navigation.UI.Views.VariationTableView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:marine_nav_trainer.Navigation.UI.Views"
             xmlns:calculator="clr-namespace:marine_nav_trainer.Calculators.UI.Controls"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             MinWidth="320"
             d:DesignHeight="600" d:DesignWidth="550">
    <Grid>
        <ui:Card VerticalAlignment="Stretch" VerticalContentAlignment="Top" HorizontalAlignment="Stretch" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="15,5,15,5"
                        BorderThickness="0,1,0,1"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:TextBlock Text="Deklinacja i czas" FontTypography="Subtitle" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <!-- Strefa czasowa -->
                <StackPanel Grid.Row="1" Margin="12,4,12,4">
                    <ui:TextBlock Text="Strefa czasowa" FontTypography="BodyStrong" Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ui:TextBlock Grid.Row="0" Grid.Column="0" Text="Strefa"/>
                        <ui:TextBlock Grid.Row="0" Grid.Column="2" Text="Data rozpoczęcia rejsu"/>

                        <ComboBox x:Name="TimeZoneBox" Grid.Row="1" Grid.Column="0" Margin="0,2,0,0"
                                  Padding="8,4,8,4"
                                  Height="31"
                                  MaxDropDownHeight="420"
                                  DisplayMemberPath="Display"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.CanContentScroll="False"/>

                        <DatePicker x:Name="StartDatePicker" Grid.Row="1" Grid.Column="2" Margin="0,2,0,0"
                                    VerticalAlignment="Top"
                                    Padding="8,4,8,4"
                                    Height="31"
                                    VerticalContentAlignment="Center"
                                    FirstDayOfWeek="Monday"
                                    SelectedDateFormat="Short"
                                    SelectedDateChanged="StartDatePicker_SelectedDateChanged"/>
                    </Grid>

                    <Separator Margin="0,12,0,8"/>

                    <!-- Deklinacja -->
                    <ui:TextBlock Text="Deklinacja główna" FontTypography="BodyStrong" Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ui:TextBlock Grid.Row="0" Grid.Column="0" Text="Deklinacja bazowa"/>
                        <ui:TextBlock Grid.Row="0" Grid.Column="2" Text="Rok bazowy"/>
                        <ui:TextBlock Grid.Row="0" Grid.Column="4" Text="Zmiana roczna (′)"/>

                        <calculator:CoordinateInputBox x:Name="BaseVariationBox" Grid.Row="1" Grid.Column="0"
                                                       Margin="0,2,0,0"
                                                       IsLatitude="False"/>

                        <ui:NumberBox x:Name="BaseYearBox" Grid.Row="1" Grid.Column="2" Margin="0,2,0,0"
                                      VerticalAlignment="Top"
                                      MinWidth="60" Padding="8,4,8,4"
                                      Minimum="1900" Maximum="2100" 
                                      MaxDecimalPlaces="0"
                                      ClearButtonEnabled="False" 
                                      SpinButtonPlacementMode="Inline"/>

                        <ui:NumberBox x:Name="AnnualChangeBox" Grid.Row="1" Grid.Column="4" Margin="0,2,0,0"
                                      VerticalAlignment="Top"
                                      MinWidth="60" Padding="8,4,8,4"
                                      Minimum="-600" Maximum="600" 
                                      MaxDecimalPlaces="2"
                                      ClearButtonEnabled="False" 
                                      SpinButtonPlacementMode="Inline"/>
                    </Grid>

                    <Separator Margin="0,12,0,8"/>

                    <!-- Deklinacja strefowa -->
                    <Grid Margin="0,0,0,6">
                        <ui:TextBlock Text="Deklinacje lokalne" FontTypography="BodyStrong" VerticalAlignment="Center"/>
                        <ui:Button Content="Dodaj"                                   
                                   Margin="460,0,0,0" Padding="6,1,6,1"
                                   Height="31"
                                   Appearance="Secondary"
                                   Click="AddLocalVariationOnClick" Width="60"/>
                    </Grid>

                    <ui:TextBlock x:Name="NoLocalVariationsText"
                                  Text="Brak deklinacji lokalnych - obowiązuje deklinacja główna."
                                  Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                  FontSize="11"
                                  TextWrapping="Wrap"/>

                    <StackPanel x:Name="LocalVariationsPanel"/>
                </StackPanel>
            </Grid>
        </ui:Card>
    </Grid>
</UserControl>
