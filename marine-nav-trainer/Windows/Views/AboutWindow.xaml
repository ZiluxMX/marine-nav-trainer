<Window x:Class="marine_nav_trainer.Windows.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="O programie"
        Width="620"
        SizeToContent="Height"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <!-- Wyśrodkowany tekst okna -->
        <Style x:Key="AboutText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>

        <Style x:Key="AboutSection" TargetType="TextBlock" BasedOn="{StaticResource AboutText}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,18,0,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="15,10"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="Info24" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <ui:TextBlock Text="O programie" FontTypography="Subtitle" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <!-- Treść okna - do uzupełnienia -->
            <StackPanel Margin="30,20,30,25">

                <ui:TextBlock x:Name="ProductText"
                              HorizontalAlignment="Center"
                              TextAlignment="Center"
                              FontTypography="Title"/>

                <TextBlock x:Name="VersionText" Style="{StaticResource AboutText}"/>

                <TextBlock Style="{StaticResource AboutSection}" Text="Autor"/>
                <TextBlock Style="{StaticResource AboutText}" Text="Michał Dziki"/>
                <TextBlock Style="{StaticResource AboutText}" Text="pod kierunkiem Promotor dr Iwony Grabskiej-Gradzińskiej"/>

                <TextBlock Style="{StaticResource AboutSection}" Text="Wydawca"/>
                <TextBlock Style="{StaticResource AboutText}" Text="Uniwersytet Jagielloński w Krakowie"/>
                <TextBlock Style="{StaticResource AboutText}" Text="Wydział Fizyki, Astronomii i Informatyki Stosowanej"/>
                <TextBlock Style="{StaticResource AboutText}" Text="Informatyka Stosowana"/>

                <TextBlock Style="{StaticResource AboutSection}" Text="Zastosowane biblioteki"/>
                <TextBlock Style="{StaticResource AboutText}" Text="WPF-UI 4.2.0 - kontrolki i motyw Fluent"/>
                <TextBlock Style="{StaticResource AboutText}" Text="PdfiumViewer 2.13.0 - renderowanie map PDF"/>
                <TextBlock Style="{StaticResource AboutText}" Text="PdfiumViewer.Native.x86_64.v8-xfa 2018.4.8.256 - silnik PDFium"/>
                <TextBlock Style="{StaticResource AboutText}" Text="MdXaml 1.27.0 - podgląd treści zadania w Markdown"/>

                <TextBlock Style="{StaticResource AboutSection}" Text="Licencja"/>
                <TextBlock Style="{StaticResource AboutText}" Text="TODO: informacja o licencji"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
