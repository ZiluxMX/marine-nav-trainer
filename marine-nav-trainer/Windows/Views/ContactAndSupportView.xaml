<Window x:Class="marine_nav_trainer.Windows.Views.ContactAndSupportView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Kontakt i wsparcie"
        Width="520"
        SizeToContent="Height"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style x:Key="SupportText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>

        <Style x:Key="SupportSection" TargetType="TextBlock" BasedOn="{StaticResource SupportText}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,18,0,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="15,10"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="Mail24" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <ui:TextBlock Text="Kontakt i wsparcie" FontTypography="Subtitle" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30,5,30,25">

                <TextBlock Style="{StaticResource SupportSection}" Text="Kontakt z autorem"/>
                <TextBlock Style="{StaticResource SupportText}" Text="Błędy, uwagi, propozycje rozwoju?"/>
                <TextBlock Style="{StaticResource SupportText}" Text="Zapraszam do zgłaszania mailowo:"/>
                <TextBlock x:Name="MailText" Style="{StaticResource SupportText}" FontStyle="Italic" Margin="0,8,0,0"/>
                <ui:Button Content="Napisz wiadomość"
                           Icon="{ui:SymbolIcon Mail24}"
                           Cursor="Hand"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,0"
                           Click="MailButton_Click"/>

                <TextBlock Style="{StaticResource SupportSection}" Text="Wsparcie projektu"/>
                <TextBlock Style="{StaticResource SupportText}" Text="Program okazał się przydatny i chcesz okazać wsparcie?"/>
                <TextBlock Style="{StaticResource SupportText}" Text="Będę wdzięczny za postawnienie mi wirtualnej kawki."/>
                <Image Source="pack://siteoforigin:,,,/Assets/Support/QR_buycoffee.png"
                       Width="200" Height="200"                       
                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                
                <Button HorizontalAlignment="Center"                        
                        Cursor="Hand"
                        ToolTip="Postaw kawę na buycoffee.to"
                        Click="CoffeeButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Image Source="pack://siteoforigin:,,,/Assets/Support/buycoffee-button.png"
                                   Width="185" Height="48"/>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
